{
  "name": "seedcoherent",
  "version": "0.0.1",
  "description": "Schema-aware synthetic data generator. Point it at your Postgres schema, get coherent, referentially-correct fake data.",
  "type": "module",
  "bin": {
    "seedcoherent": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx test/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "postgres",
    "seed",
    "fake-data",
    "synthetic-data",
    "faker",
    "database",
    "testing",
    "fixtures"
  ],
  "license": "MIT",
  "dependencies": {
    "@faker-js/faker": "^9.3.0",
    "commander": "^12.1.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
