{
  "name": "seedcoherent",
  "version": "0.4.0",
  "description": "Schema-aware synthetic data generator. Point it at your Postgres, MySQL, or SQLite schema, get coherent, referentially-correct fake data.",
  "type": "module",
  "bin": {
    "seedcoherent": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "author": "Jacob Jensen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jajjer/seedcoherent.git"
  },
  "homepage": "https://github.com/jajjer/seedcoherent#readme",
  "bugs": {
    "url": "https://github.com/jajjer/seedcoherent/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx test/*.test.ts",
    "demo": "npm run build && vhs demo/demo.tape",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "postgres",
    "mysql",
    "sqlite",
    "seed",
    "fake-data",
    "synthetic-data",
    "test-data",
    "faker",
    "database",
    "database-testing",
    "data-anonymization",
    "testing",
    "fixtures"
  ],
  "license": "MIT",
  "dependencies": {
    "@faker-js/faker": "^9.3.0",
    "better-sqlite3": "^12.11.1",
    "commander": "^12.1.0",
    "mysql2": "^3.23.2",
    "pg": "^8.13.1",
    "pg-copy-streams": "^7.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/pg-copy-streams": "^1.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
